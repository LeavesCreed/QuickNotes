<Window x:Class="WindowsWindowTrayPrototype.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测试便签" Height="240" Width="300"
        MinHeight="170" MinWidth="220"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="False"
        WindowStartupLocation="Manual"
        Closing="NoteWindow_Closing">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="窗口测试便签" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <CheckBox x:Name="TopmostCheck" Content="置顶" Margin="14,0,0,0"
                      VerticalAlignment="Center" Checked="TopmostCheck_Changed"
                      Unchecked="TopmostCheck_Changed"/>
        </StackPanel>
        <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Text="在这里输入测试文本。点击窗口右上角 X 应只隐藏这张便签。"/>
    </DockPanel>
</Window>
