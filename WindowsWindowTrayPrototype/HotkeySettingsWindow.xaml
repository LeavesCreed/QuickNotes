<Window x:Class="WindowsWindowTrayPrototype.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局快捷键设置" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="操作" FontWeight="SemiBold" Margin="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="启用" FontWeight="SemiBold" Margin="4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="修饰键" FontWeight="SemiBold" Margin="4"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="按键" FontWeight="SemiBold" Margin="4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="新建便签" VerticalAlignment="Center" Margin="4"/>
        <CheckBox x:Name="NewEnabled" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="4"/>
        <ComboBox x:Name="NewModifiers" Grid.Row="1" Grid.Column="2" Margin="4"/>
        <ComboBox x:Name="NewKey" Grid.Row="1" Grid.Column="3" Margin="4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="打开管理中心" VerticalAlignment="Center" Margin="4"/>
        <CheckBox x:Name="ManagerEnabled" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="4"/>
        <ComboBox x:Name="ManagerModifiers" Grid.Row="2" Grid.Column="2" Margin="4"/>
        <ComboBox x:Name="ManagerKey" Grid.Row="2" Grid.Column="3" Margin="4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="全局隐藏／恢复" VerticalAlignment="Center" Margin="4"/>
        <CheckBox x:Name="GlobalEnabled" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="4"/>
        <ComboBox x:Name="GlobalModifiers" Grid.Row="3" Grid.Column="2" Margin="4"/>
        <ComboBox x:Name="GlobalKey" Grid.Row="3" Grid.Column="3" Margin="4"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="应用" Click="Save_Click" Padding="18,7" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
