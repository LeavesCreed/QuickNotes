<Window x:Class="QuickNotes.Desktop.Wpf.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理分类"
        Width="520"
        Height="430"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="分类（“未分类”为系统保留，不可删除）" Foreground="#555555" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
            <TextBlock Text="名称：" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Width="140" Padding="5" Margin="4,0,10,0" />
            <TextBlock Text="颜色：" VerticalAlignment="Center" />
            <TextBox x:Name="ColorBox" Width="95" Padding="5" Margin="4,0,10,0" />
            <Button Content="新增" Padding="10,4" Margin="0,0,6,0" Click="AddButton_Click" />
            <Button Content="保存选中" Padding="10,4" Click="SaveButton_Click" />
        </StackPanel>
        <ListBox x:Name="CategoryList" Grid.Row="2" SelectionChanged="CategoryList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DefaultColor}" Foreground="#777777" Margin="10,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="删除时转移到：" VerticalAlignment="Center" />
            <ComboBox x:Name="DeleteTargetCombo" Grid.Column="1" Margin="4,0,8,0" DisplayMemberPath="Name" />
            <Button Grid.Column="2" Content="删除选中" Padding="10,4" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button Grid.Column="3" Content="关闭" Padding="10,4" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
