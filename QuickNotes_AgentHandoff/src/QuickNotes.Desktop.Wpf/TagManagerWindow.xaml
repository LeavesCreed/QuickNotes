<Window x:Class="QuickNotes.Desktop.Wpf.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理标签"
        Width="500"
        Height="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="标签（删除只解除关联，不删除便签）" Foreground="#555555" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
            <TextBlock Text="名称：" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Width="180" Padding="5" Margin="4,0,10,0" />
            <Button Content="新增" Padding="10,4" Margin="0,0,6,0" Click="AddButton_Click" />
            <Button Content="保存选中" Padding="10,4" Click="SaveButton_Click" />
        </StackPanel>
        <ListBox x:Name="TagList" Grid.Row="2" SelectionChanged="TagList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="合并目标：" VerticalAlignment="Center" />
            <ComboBox x:Name="MergeTargetCombo" Grid.Column="1" Margin="4,0,8,0" DisplayMemberPath="Name" />
            <Button Grid.Column="2" Content="合并选中" Padding="10,4" Margin="0,0,8,0" Click="MergeButton_Click" />
            <Button Grid.Column="3" Content="删除选中" Padding="10,4" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button Grid.Column="4" Content="关闭" Padding="10,4" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
