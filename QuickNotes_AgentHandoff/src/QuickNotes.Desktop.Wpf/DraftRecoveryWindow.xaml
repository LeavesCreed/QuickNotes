<Window x:Class="QuickNotes.Desktop.Wpf.DraftRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="恢复未保存草稿"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="默认不自动提交草稿。请先查看内容，再选择恢复或丢弃。"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <ListBox x:Name="DraftsList"
                 Grid.Row="1"
                 SelectionChanged="DraftsList_SelectionChanged" />

        <TextBox x:Name="DraftPreview"
                 Grid.Row="2"
                 Margin="0,8,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="6" />

        <TextBlock x:Name="IssuesText"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="#A94442"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RestoreButton" Content="恢复选中草稿" Padding="12,6" Margin="0,0,8,0" Click="RestoreButton_Click" />
            <Button x:Name="DiscardButton" Content="丢弃选中草稿" Padding="12,6" Margin="0,0,8,0" Click="DiscardButton_Click" />
            <Button Content="关闭" Padding="12,6" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
