<Window x:Class="QuickNotes.Desktop.Wpf.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNotes 管理中心"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Key="S" Modifiers="Control" />
    </Window.InputBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="NewButton" Content="新建" Padding="14,6" Margin="0,0,8,0" Click="NewButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Padding="14,6" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="RefreshButton" Content="刷新" Padding="14,6" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="DraftsButton" Content="草稿恢复" Padding="14,6" Margin="0,0,8,0" Click="DraftsButton_Click" />
            <Button x:Name="BackupButton" Content="备份与恢复" Padding="14,6" Margin="0,0,8,0" Click="BackupButton_Click" />
            <Button x:Name="SettingsButton" Content="设置" Padding="14,6" Click="SettingsButton_Click" />
            <TextBlock x:Name="BackupStatusText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#666666" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="搜索：" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox"
                     Width="240"
                     Padding="6"
                     Margin="4,0,12,0"
                     TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="IncludeArchivedCheckBox"
                      Content="包含归档"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      Click="IncludeArchivedCheckBox_Click" />
            <TextBlock Text="分类：" VerticalAlignment="Center" />
            <ComboBox x:Name="CategoryFilterCombo"
                      Width="140"
                      Margin="4,0,12,0"
                      DisplayMemberPath="Name"
                      SelectionChanged="CategoryFilterCombo_SelectionChanged" />
            <Button x:Name="ManageCategoriesButton" Content="管理分类" Padding="10,4" Margin="0,0,12,0" Click="ManageCategoriesButton_Click" />
            <Button x:Name="ManageTagsButton" Content="管理标签" Padding="10,4" Click="ManageTagsButton_Click" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox x:Name="NavigationList"
                         Height="80"
                         SelectionChanged="NavigationList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="标签筛选（可多选，任一匹配）" Foreground="#555555" />
                    <ListBox x:Name="TagFilterList"
                             Grid.Row="1"
                             Height="90"
                             SelectionMode="Multiple"
                             SelectionChanged="TagFilterList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <TextBlock x:Name="SelectionText"
                           Grid.Row="2"
                           Margin="0,8,0,4"
                           Foreground="#666666"
                           TextWrapping="Wrap" />

                <ListBox x:Name="NotesList"
                         Grid.Row="3"
                         SelectionMode="Extended"
                         SelectionChanged="NotesList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding TitleDisplay}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PreviewDisplay}"
                                           Foreground="#666666"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ModifiedDisplay}"
                                           FontSize="10"
                                           Foreground="#999999" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True" />

            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="标题" Foreground="#555555" />
                <TextBox x:Name="TitleBox"
                         Grid.Row="1"
                         Margin="0,4,0,8"
                         Padding="6"
                         TextChanged="EditorTextChanged"
                         LostKeyboardFocus="EditorLostKeyboardFocus" />

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="分类：" VerticalAlignment="Center" />
                    <ComboBox x:Name="CategoryEditorCombo"
                              Grid.Column="1"
                              Margin="4,0,12,0"
                              DisplayMemberPath="Name"
                              SelectionChanged="CategoryEditorCombo_SelectionChanged" />
                    <CheckBox x:Name="PinCheckBox"
                              Grid.Column="2"
                              Content="置顶"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Click="PinCheckBox_Click" />
                    <Button x:Name="CopyButton"
                            Grid.Column="3"
                            Content="创建副本"
                            Padding="10,4"
                            Click="CopyButton_Click" />
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="颜色：" VerticalAlignment="Center" />
                    <ComboBox x:Name="ColorModeCombo"
                              Width="110"
                              Margin="4,0,8,0"
                              DisplayMemberPath="Display"
                              SelectionChanged="ColorModeCombo_SelectionChanged" />
                    <TextBox x:Name="ColorHexBox"
                             Width="90"
                             Padding="5"
                             Margin="0,0,12,0"
                             LostKeyboardFocus="AppearanceBox_LostKeyboardFocus" />
                    <TextBlock Text="字号：" VerticalAlignment="Center" />
                    <TextBox x:Name="FontSizeBox"
                             Width="55"
                             Padding="5"
                             Margin="4,0,4,0"
                             LostKeyboardFocus="AppearanceBox_LostKeyboardFocus" />
                    <TextBlock Text="（空=跟随全局）" Foreground="#777777" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="标签（Ctrl 多选）" Foreground="#555555" />
                <ListBox x:Name="TagsEditorList"
                         Grid.Row="5"
                         Height="76"
                         Margin="0,4,0,8"
                         SelectionMode="Multiple"
                         SelectionChanged="TagsEditorList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBox x:Name="BodyBox"
                         Grid.Row="6"
                         Margin="0,0,0,8"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="EditorTextChanged"
                         LostKeyboardFocus="EditorLostKeyboardFocus" />

                <StackPanel Grid.Row="7">
                    <Border x:Name="ConflictPanel"
                            Visibility="Collapsed"
                            BorderBrush="#D9534F"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="版本冲突：本地内容已保留，未自动合并。"
                                       FontWeight="SemiBold"
                                       Foreground="#A94442"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ConflictText"
                                       Margin="0,4,0,6"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="数据库版本正文：" Foreground="#555555" />
                            <TextBox x:Name="ConflictPreview"
                                     Margin="0,2,0,6"
                                     Height="90"
                                     Padding="6"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ReloadButton" Content="重新载入数据库版本" Padding="10,4" Margin="0,0,8,0" Click="ReloadButton_Click" />
                                <Button x:Name="SaveAsNewButton" Content="另存为新便签" Padding="10,4" Click="SaveAsNewButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DraftStatusText" Foreground="#666666" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorText" Foreground="#A94442" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="RetrySaveButton" Content="重试保存" Padding="10,4" Margin="0,0,8,0" Click="RetrySaveButton_Click" />
                        <Button x:Name="RetryDraftButton" Content="重试草稿保护" Padding="10,4" Click="RetryDraftButton_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ArchiveButton" Content="归档" Padding="10,4" Margin="0,0,6,0" Click="ArchiveButton_Click" />
                    <Button x:Name="TrashButton" Content="移入回收站" Padding="10,4" Margin="0,0,6,0" Click="TrashButton_Click" />
                    <Button x:Name="RestoreButton" Content="恢复" Padding="10,4" Margin="0,0,6,0" Click="RestoreButton_Click" />
                    <Button x:Name="DeleteButton" Content="永久删除" Padding="10,4" Margin="0,0,6,0" Click="DeleteButton_Click" />
                    <Button x:Name="UndoButton" Content="撤销上一管理操作" Padding="10,4" Click="UndoButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BatchArchiveButton" Content="归档" Padding="10,4" Margin="4,0,6,0" Click="BatchArchiveButton_Click" />
                    <Button x:Name="BatchTrashButton" Content="移入回收站" Padding="10,4" Margin="0,0,6,0" Click="BatchTrashButton_Click" />
                    <Button x:Name="BatchMoveCategoryButton" Content="移动到分类" Padding="10,4" Margin="0,0,6,0" Click="BatchMoveCategoryButton_Click" />
                    <ComboBox x:Name="BatchCategoryCombo"
                              Width="120"
                              Margin="0,0,10,0"
                              DisplayMemberPath="Name" />
                    <ComboBox x:Name="BatchTagCombo"
                              Width="120"
                              Margin="0,0,6,0"
                              DisplayMemberPath="Name" />
                    <Button x:Name="BatchAddTagButton" Content="加标签" Padding="10,4" Margin="0,0,6,0" Click="BatchAddTagButton_Click" />
                    <Button x:Name="BatchRemoveTagButton" Content="移除标签" Padding="10,4" Click="BatchRemoveTagButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="#888888"
                   TextWrapping="Wrap"
                   Text="C5 管理中心：分类/标签/归档/回收站/搜索/多选/撤销；独立便签窗口、托盘、全局快捷键与 DPI 适配属于 C5 桌面行为批次。" />
    </Grid>
</Window>
