<Window x:Class="QuickNotes.Desktop.Wpf.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNotes"
        Width="1040"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Key="S" Modifiers="Control" />
    </Window.InputBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="NewButton" Content="新建" Padding="14,6" Margin="0,0,8,0" Click="NewButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Padding="14,6" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="RefreshButton" Content="刷新" Padding="14,6" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="DraftsButton" Content="草稿恢复" Padding="14,6" Click="DraftsButton_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NotesList"
                     SelectionChanged="NotesList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding TitleDisplay}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PreviewDisplay}"
                                       Foreground="#666666"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModifiedDisplay}"
                                       FontSize="10"
                                       Foreground="#999999" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True" />

            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="标题" Foreground="#555555" />
                <TextBox x:Name="TitleBox"
                         Grid.Row="1"
                         Margin="0,4,0,10"
                         Padding="6"
                         TextChanged="EditorTextChanged"
                         LostKeyboardFocus="EditorLostKeyboardFocus" />

                <TextBlock Grid.Row="2" Text="正文" Foreground="#555555" />
                <TextBox x:Name="BodyBox"
                         Grid.Row="3"
                         Margin="0,4,0,10"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="EditorTextChanged"
                         LostKeyboardFocus="EditorLostKeyboardFocus" />

                <StackPanel Grid.Row="4">
                    <Border x:Name="ConflictPanel"
                            Visibility="Collapsed"
                            BorderBrush="#D9534F"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="版本冲突：本地内容已保留，未自动合并。"
                                       FontWeight="SemiBold"
                                       Foreground="#A94442"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ConflictText"
                                       Margin="0,4,0,6"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="数据库版本正文："
                                       Foreground="#555555" />
                            <TextBox x:Name="ConflictPreview"
                                     Margin="0,2,0,6"
                                     Height="90"
                                     Padding="6"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ReloadButton" Content="重新载入数据库版本" Padding="10,4" Margin="0,0,8,0" Click="ReloadButton_Click" />
                                <Button x:Name="SaveAsNewButton" Content="另存为新便签" Padding="10,4" Click="SaveAsNewButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DraftStatusText" Foreground="#666666" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorText" Foreground="#A94442" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="RetrySaveButton" Content="重试保存" Padding="10,4" Margin="0,0,8,0" Click="RetrySaveButton_Click" />
                        <Button x:Name="RetryDraftButton" Content="重试草稿保护" Padding="10,4" Click="RetryDraftButton_Click" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="5"
                           Margin="0,8,0,0"
                           Foreground="#888888"
                           TextWrapping="Wrap"
                           Text="C2 最小编辑器：仅当前便签的标题/正文；分类、标签、生命周期、备份恢复 UI 不在本阶段。" />
            </Grid>
        </Grid>
    </Grid>
</Window>
