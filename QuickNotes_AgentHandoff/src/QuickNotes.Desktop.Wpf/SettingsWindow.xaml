<Window x:Class="QuickNotes.Desktop.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNotes 设置"
        Width="580"
        Height="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <TextBlock Text="常规" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="默认字号：" VerticalAlignment="Center" />
            <TextBox x:Name="DefaultFontSizeBox" Grid.Column="1" Width="80" HorizontalAlignment="Left" Padding="5" />
            <CheckBox x:Name="NotificationsCheckBox" Grid.Row="1" Grid.Column="1" Content="启用系统通知" Margin="0,8,0,0" />
            <CheckBox x:Name="GlobalHiddenCheckBox" Grid.Row="2" Grid.Column="1" Content="全局隐藏桌面便签（不改变单张隐藏状态）" Margin="0,8,0,0" />
            <CheckBox x:Name="StartupCheckBox" Grid.Row="3" Grid.Column="1" Content="开机启动（--startup，登录后不显示管理中心）" Margin="0,8,0,0" />
            <TextBlock x:Name="StartupStatusText" Grid.Row="3" Grid.Column="1" Margin="0,28,0,0" Foreground="#777777" TextWrapping="Wrap" />
        </Grid>

        <TextBlock Grid.Row="2" Text="顶栏动作（全局统一）" FontWeight="SemiBold" />
        <WrapPanel Grid.Row="3" Margin="0,8,0,10">
            <CheckBox x:Name="TopBarPinCheckBox" Content="置顶" Margin="0,0,14,0" />
            <CheckBox x:Name="TopBarCategoryCheckBox" Content="分类" Margin="0,0,14,0" />
            <CheckBox x:Name="TopBarColorCheckBox" Content="颜色" Margin="0,0,14,0" />
            <CheckBox x:Name="TopBarFontSizeCheckBox" Content="字号" Margin="0,0,14,0" />
            <CheckBox x:Name="TopBarMoreCheckBox" Content="更多" />
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="全局快捷键（留空禁用；格式如 Ctrl+Alt+N）" FontWeight="SemiBold" />
        <Grid Grid.Row="5" Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="新建便签：" VerticalAlignment="Center" />
            <TextBox x:Name="NewHotkeyBox" Grid.Column="1" Padding="5" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Text="管理中心：" VerticalAlignment="Center" />
            <TextBox x:Name="ManagementHotkeyBox" Grid.Row="1" Grid.Column="1" Padding="5" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Text="全局隐藏/恢复：" VerticalAlignment="Center" />
            <TextBox x:Name="ToggleHotkeyBox" Grid.Row="2" Grid.Column="1" Padding="5" />
        </Grid>

        <StackPanel Grid.Row="6">
            <TextBlock Text="备份" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="备份目录：" VerticalAlignment="Center" />
                <TextBlock x:Name="BackupDirectoryText" Margin="6,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Content="备份设置" Padding="10,4" Click="BackupSettingsButton_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="ErrorText" Foreground="#A94442" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Button Content="保存" Padding="12,6" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="关闭" Padding="12,6" IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
