<Window x:Class="QuickNotes.Desktop.Wpf.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份与恢复"
        Width="920"
        Height="660"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="备份目录：" VerticalAlignment="Center" />
            <TextBlock x:Name="DirectoryText"
                       Grid.Column="1"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="ConfigureButton"
                    Grid.Column="2"
                    Content="选择目录"
                    Padding="12,6"
                    Click="ConfigureButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="WarningText" Foreground="#A94442" TextWrapping="Wrap" />
            <TextBlock x:Name="IssuesText" Foreground="#A94442" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
            <Button x:Name="ManualBackupButton" Content="立即手动备份" Padding="12,6" Margin="0,0,8,0" Click="ManualBackupButton_Click" />
            <Button x:Name="RetryCheckButton" Content="重试检查" Padding="12,6" Margin="0,0,8,0" Click="RetryCheckButton_Click" />
            <Button x:Name="RefreshButton" Content="刷新列表" Padding="12,6" Click="RefreshButton_Click" />
        </StackPanel>

        <ListBox x:Name="BackupsList"
                 Grid.Row="3"
                 SelectionChanged="BackupsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,5">
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Foreground="#666666" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="VerifyButton" Content="校验选中备份" Padding="12,6" Margin="0,0,8,0" Click="VerifyButton_Click" />
            <Button x:Name="DeleteButton" Content="删除手动备份" Padding="12,6" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button x:Name="RestoreButton" Content="从此备份恢复" Padding="12,6" Click="RestoreButton_Click" />
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BusyText" Foreground="#666666" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="关闭"
                    Padding="12,6"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
