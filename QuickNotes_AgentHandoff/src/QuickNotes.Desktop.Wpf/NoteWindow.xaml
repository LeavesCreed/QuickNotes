<Window x:Class="QuickNotes.Desktop.Wpf.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="便签"
        Width="360"
        Height="420"
        MinWidth="260"
        MinHeight="220"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent">
    <Border x:Name="RootBorder"
            BorderBrush="#66000000"
            BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TopBar"
                    Background="#22000000"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TopBarTitle"
                               Text="便签"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton x:Name="PinButton"
                                      Content="置顶"
                                      Padding="6,2"
                                      Margin="0,0,4,0"
                                      Click="PinButton_Click" />
                        <Button x:Name="MoreButton"
                                Content="更多"
                                Padding="6,2"
                                Margin="0,0,4,0">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="隐藏便签" Click="HideMenuItem_Click" />
                                    <MenuItem Header="打开管理中心" Click="OpenManagementMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="归档" Click="ArchiveMenuItem_Click" />
                                    <MenuItem Header="移入回收站" Click="TrashMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ColorMenu" Header="颜色" />
                                    <MenuItem x:Name="FontSizeMenu" Header="字号" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="CloseButton"
                                Content="×"
                                Padding="8,2"
                                ToolTip="隐藏便签"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,8,10,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="TitleBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Padding="0,2,0,6"
                         TextChanged="EditorTextChanged"
                         LostKeyboardFocus="EditorLostKeyboardFocus" />
                <TextBox x:Name="BodyBox"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="0"
                         TextChanged="EditorTextChanged"
                         LostKeyboardFocus="EditorLostKeyboardFocus" />
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Foreground="#665544"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SaveStatusText"
                           Grid.Column="1"
                           Foreground="#665544"
                           FontSize="11"
                           Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
